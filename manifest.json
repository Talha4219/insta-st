{
  "manifest_version": 3,
  "name": "IG Toggle Helper",
  "version": "1.1",
  "description": "Automate story hiding/showing on Instagram.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}